# قالب إعدادات الإنتاج - انسخه كـ .env على السيرفر وعبّي القيم. لا ترفع .env لأي مكان.
APP_NAME="Restaurant POS"
APP_ENV=production
APP_KEY=              # php artisan key:generate (مفتاح جديد، مش نفس مفتاح التطوير)
APP_DEBUG=false       # لازم false، true بيعرض الكود والـ stack trace والإعدادات للمستخدم
APP_URL=https://api.example.com
APP_TIMEZONE=UTC      # غيّرها لتوقيت المطعم حتى تقارير "اليوم" تنقطع صح

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# SQLite مناسبة للتطوير بس. للإنتاج مع أكتر من كاشير استخدم MySQL/Postgres
# (SQLite بتتجاهل lockForUpdate، والحماية من التزامن بتعتمد عليه)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# أصول الفرونت المسموحة (CORS)، مفصولة بفاصلة
CORS_ALLOWED_ORIGINS=https://pos.example.com
# مدة صلاحية التوكن بالدقائق (10080 = أسبوع)
SANCTUM_EXPIRATION=10080

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
