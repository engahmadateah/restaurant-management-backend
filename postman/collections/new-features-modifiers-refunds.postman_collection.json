{
  "info": {
    "name": "Restaurant Backend - New Features (Modifiers & Refunds)",
    "description": "مجموعة Postman للميزتين الجديدتين: خيارات إضافية للأصناف (Modifiers/Add-ons) واسترجاع الأموال (Refunds). استورد هاد الملف زي ما هو بـ Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "menu_item_id", "value": "1" },
    { "key": "modifier_group_id", "value": "1" },
    { "key": "modifier_id", "value": "1" },
    { "key": "order_id", "value": "1" },
    { "key": "payment_id", "value": "1" },
    { "key": "refund_id", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. تسجيل دخول (Login) - للحصول على التوكن",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@restaurant.com\",\n  \"password\": \"password\"\n}"
        },
        "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
      },
      "auth": { "type": "noauth" }
    },
    {
      "name": "Modifiers - الخيارات الإضافية للأصناف",
      "item": [
        {
          "name": "1. إنشاء مجموعة خيارات (مع خيارات مباشرة) - الحجم",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"الحجم\",\n  \"is_required\": true,\n  \"max_selections\": 1,\n  \"sort_order\": 1,\n  \"modifiers\": [\n    { \"name\": \"وسط\", \"extra_price\": 0 },\n    { \"name\": \"كبير\", \"extra_price\": 3.00 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/menu-items/{{menu_item_id}}/modifier-groups",
              "host": ["{{base_url}}"],
              "path": ["menu-items", "{{menu_item_id}}", "modifier-groups"]
            }
          }
        },
        {
          "name": "2. إنشاء مجموعة خيارات - إضافات (اختياري، أكتر من خيار)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"إضافات\",\n  \"is_required\": false,\n  \"max_selections\": 3,\n  \"sort_order\": 2,\n  \"modifiers\": [\n    { \"name\": \"جبنة إضافية\", \"extra_price\": 1.50 },\n    { \"name\": \"صوص ثوم\", \"extra_price\": 0.50 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/menu-items/{{menu_item_id}}/modifier-groups",
              "host": ["{{base_url}}"],
              "path": ["menu-items", "{{menu_item_id}}", "modifier-groups"]
            }
          }
        },
        {
          "name": "3. عرض كل مجموعات الخيارات لصنف معيّن",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/menu-items/{{menu_item_id}}/modifier-groups",
              "host": ["{{base_url}}"],
              "path": ["menu-items", "{{menu_item_id}}", "modifier-groups"]
            }
          }
        },
        {
          "name": "4. تعديل مجموعة خيارات",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"الحجم\",\n  \"is_required\": true,\n  \"max_selections\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/menu-items/{{menu_item_id}}/modifier-groups/{{modifier_group_id}}",
              "host": ["{{base_url}}"],
              "path": ["menu-items", "{{menu_item_id}}", "modifier-groups", "{{modifier_group_id}}"]
            }
          }
        },
        {
          "name": "5. إضافة خيار جديد لمجموعة موجودة",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"عائلي (XL)\",\n  \"extra_price\": 6.00,\n  \"is_available\": true,\n  \"sort_order\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/menu-items/{{menu_item_id}}/modifier-groups/{{modifier_group_id}}/modifiers",
              "host": ["{{base_url}}"],
              "path": ["menu-items", "{{menu_item_id}}", "modifier-groups", "{{modifier_group_id}}", "modifiers"]
            }
          }
        },
        {
          "name": "6. تعديل خيار",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"extra_price\": 3.50,\n  \"is_available\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/menu-items/{{menu_item_id}}/modifier-groups/{{modifier_group_id}}/modifiers/{{modifier_id}}",
              "host": ["{{base_url}}"],
              "path": ["menu-items", "{{menu_item_id}}", "modifier-groups", "{{modifier_group_id}}", "modifiers", "{{modifier_id}}"]
            }
          }
        },
        {
          "name": "7. حذف خيار",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/menu-items/{{menu_item_id}}/modifier-groups/{{modifier_group_id}}/modifiers/{{modifier_id}}",
              "host": ["{{base_url}}"],
              "path": ["menu-items", "{{menu_item_id}}", "modifier-groups", "{{modifier_group_id}}", "modifiers", "{{modifier_id}}"]
            }
          }
        },
        {
          "name": "8. حذف مجموعة خيارات كاملة",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/menu-items/{{menu_item_id}}/modifier-groups/{{modifier_group_id}}",
              "host": ["{{base_url}}"],
              "path": ["menu-items", "{{menu_item_id}}", "modifier-groups", "{{modifier_group_id}}"]
            }
          }
        },
        {
          "name": "9. إنشاء طلب فيه صنف مع خيارات مختارة (modifiers)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_type\": \"dine_in\",\n  \"table_id\": 1,\n  \"customer_id\": 1,\n  \"notes\": \"بدون بصل بالسلطة\",\n  \"items\": [\n    {\n      \"menu_item_id\": {{menu_item_id}},\n      \"quantity\": 2,\n      \"notes\": \"حار شوي\",\n      \"modifiers\": [1, 3]\n    },\n    {\n      \"menu_item_id\": 5,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/orders", "host": ["{{base_url}}"], "path": ["orders"] }
          }
        }
      ]
    },
    {
      "name": "Refunds - الاسترجاعات",
      "item": [
        {
          "name": "1. طلب استرجاع جديد (كاشير/أدمن)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": {{order_id}},\n  \"payment_id\": {{payment_id}},\n  \"amount\": 15.50,\n  \"reason\": \"الزبون استلم صنف غلط والمطعم وافق على استرجاع قيمته\"\n}"
            },
            "url": { "raw": "{{base_url}}/refunds", "host": ["{{base_url}}"], "path": ["refunds"] }
          }
        },
        {
          "name": "2. عرض كل طلبات الاسترجاع (فلترة اختيارية status/order_id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/refunds?status=pending",
              "host": ["{{base_url}}"],
              "path": ["refunds"],
              "query": [{ "key": "status", "value": "pending" }]
            }
          }
        },
        {
          "name": "3. عرض طلب استرجاع واحد",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/refunds/{{refund_id}}",
              "host": ["{{base_url}}"],
              "path": ["refunds", "{{refund_id}}"]
            }
          }
        },
        {
          "name": "4. موافقة الأدمن على الاسترجاع",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_note\": \"تمت الموافقة بعد مراجعة الطلب مع الكاشير\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/refunds/{{refund_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["refunds", "{{refund_id}}", "approve"]
            }
          }
        },
        {
          "name": "5. رفض طلب الاسترجاع",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_note\": \"لا يوجد سبب كافٍ للاسترجاع - تم تسليم الطلب الصحيح\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/refunds/{{refund_id}}/reject",
              "host": ["{{base_url}}"],
              "path": ["refunds", "{{refund_id}}", "reject"]
            }
          }
        }
      ]
    }
  ]
}
